{
  "name": "vapt-pdv",
  "version": "0.1.0",
  "description": "VaptPDV — Sistema Distribuído de Ponto de Venda para Bares e Lanchonetes",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "npm --prefix ../frontend run dev",
    "build": "prisma generate && tsc",
    "build:frontend": "npm --prefix ../frontend run build",
    "build:all": "npm run build && npm run build:frontend",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "npm --prefix ../frontend run typecheck",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@prisma/client": "^6.4.1",
    "@sinclair/typebox": "^0.34.18",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
