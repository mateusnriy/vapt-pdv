generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  garcom
  caixa
  gerente
}

model Usuario {
  id            Int           @id @default(autoincrement())
  nome          String
  perfil        PerfilUsuario
  ativo         Boolean       @default(true)
  criado_em     DateTime      @default(now())
  atualizado_em DateTime      @updatedAt

  @@map("usuarios")
}

model Produto {
  id             Int      @id @default(autoincrement())
  nome           String
  categoria      String
  preco          Decimal  @db.Decimal(10, 2)
  estoque        Int
  estoque_minimo Int      @default(0)
  ativo          Boolean  @default(true)
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  @@map("produtos")
}

model MovimentoEstoque {
  id         Int      @id @default(autoincrement())
  produto_id Int
  quantidade Int
  motivo     String
  comanda_id Int?
  criado_em  DateTime @default(now())

  @@index([comanda_id])
  @@index([produto_id])
  @@map("movimentos_estoque")
}

enum StatusComanda {
  aberta
  fechada
  paga
  cancelada
}

enum FormaPagamento {
  dinheiro
  pix
  cartao
}

model Comanda {
  id              Int             @id @default(autoincrement())
  mesa            String
  nome_cliente    String?
  garcom_id       Int
  status          StatusComanda   @default(aberta)
  subtotal        Decimal?        @db.Decimal(10, 2)
  taxa_servico    Decimal?        @db.Decimal(10, 2)
  total           Decimal?        @db.Decimal(10, 2)
  forma_pagamento FormaPagamento?
  aberta_em       DateTime        @default(now())
  fechada_em      DateTime?
  paga_em         DateTime?
  itens           ItemComanda[]

  @@index([status])
  @@index([mesa])
  @@index([aberta_em])
  @@map("comandas")
}

model ItemComanda {
  id            Int     @id @default(autoincrement())
  comanda_id    Int
  produto_id    Int
  nome_copiado  String
  preco_copiado Decimal @db.Decimal(10, 2)
  quantidade    Int
  comanda       Comanda @relation(fields: [comanda_id], references: [id], onDelete: Cascade)

  @@index([comanda_id])
  @@index([produto_id])
  @@map("itens_comanda")
}
